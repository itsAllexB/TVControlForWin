<!-- A small "i" button placed after a label. Click, tap or Enter opens a flyout with the longer
     explanation, so it stays off the page until someone asks for it. -->
<UserControl
    x:Class="TVControlForWin.Controls.InfoTip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False"
    VerticalAlignment="Center">

    <Button x:Name="InfoButton"
            Style="{StaticResource InfoTipButtonStyle}"
            AutomationProperties.Name="More information"
            ToolTipService.ToolTip="More information">
        <FontIcon Glyph="&#xE946;" FontSize="14" />
        <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
                <Flyout.FlyoutPresenterStyle>
                    <Style TargetType="FlyoutPresenter">
                        <Setter Property="MaxWidth" Value="380" />
                        <Setter Property="Padding" Value="16,12,16,14" />
                    </Style>
                </Flyout.FlyoutPresenterStyle>
                <StackPanel MaxWidth="330" Spacing="6">
                    <TextBlock x:Name="TitleText" Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="BodyText" TextWrapping="Wrap" LineHeight="20" />
                </StackPanel>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
