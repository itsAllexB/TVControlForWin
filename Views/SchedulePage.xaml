<Page
    x:Class="TVControlForWin.Views.SchedulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TVControlForWin.ViewModels"
    xmlns:controls="using:TVControlForWin.Controls">

    <Grid RowDefinitions="Auto,*">
        <TextBlock Text="Schedule" Style="{StaticResource PageTitleStyle}" />

        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled">
            <StackPanel Style="{StaticResource PageContentStyle}">

                <!-- Catch-up on startup -->
                <controls:SettingCard Header="Apply current schedule at startup" Glyph="&#xE81C;"
                                      InfoText="When the app starts, each TV is set to the schedule in effect at that moment. That covers schedules that ran while the PC was off.">
                    <ToggleSwitch MinWidth="0" IsOn="{x:Bind VM.ApplyScheduleOnStartup, Mode=TwoWay}" />
                </controls:SettingCard>

                <!-- Header with the Add button -->
                <Grid ColumnDefinitions="*,Auto" Margin="1,20,0,4">
                    <TextBlock Text="Schedules" Style="{StaticResource SectionHeaderTextStyle}" />
                    <Button Grid.Column="1" Command="{x:Bind VM.AddScheduleCommand}"
                            AutomationProperties.Name="Add schedule">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="Add schedule" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- List -->
                <ItemsControl ItemsSource="{x:Bind VM.Schedules}" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ScheduleViewModel">
                            <Border Style="{StaticResource CardStyle}" Padding="16,12">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
                                    <TimePicker Grid.Column="0" VerticalAlignment="Center"
                                                AutomationProperties.Name="Time"
                                                ClockIdentifier="{x:Bind ClockId}"
                                                Time="{x:Bind Time, Mode=TwoWay}" />

                                    <Grid Grid.Column="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                        <FontIcon Grid.Column="0" Glyph="&#xE706;" FontSize="16" VerticalAlignment="Center"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                                AutomationProperties.Name="Brightness"
                                                Value="{x:Bind Brightness, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="2" MinWidth="40" TextAlignment="Right" VerticalAlignment="Center">
                                            <Run Text="{x:Bind Brightness, Mode=OneWay}" /><Run Text="%" />
                                        </TextBlock>
                                    </Grid>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <!-- Which TVs it changes. Only with two or more TVs that can be dimmed;
                                             the flyout is filled as it opens (see OnTvFlyoutOpening). -->
                                        <!-- Fixed width, so the sliders line up whatever each label says. -->
                                        <DropDownButton VerticalAlignment="Center" Width="140"
                                                        HorizontalContentAlignment="Left"
                                                        AutomationProperties.AutomationId="TvPicker"
                                                        AutomationProperties.Name="{x:Bind TargetLabel, Mode=OneWay}"
                                                        ToolTipService.ToolTip="TVs this schedule changes"
                                                        Visibility="{x:Bind TvPickerVisibility, Mode=OneWay}"
                                                        Tag="{x:Bind}">
                                            <TextBlock Text="{x:Bind TargetLabel, Mode=OneWay}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <DropDownButton.Flyout>
                                                <Flyout Placement="Bottom" Opening="OnTvFlyoutOpening">
                                                    <StackPanel MinWidth="160">
                                                        <CheckBox Content="All TVs" Click="OnAllTvsClick" />
                                                        <Border Style="{StaticResource DividerStyle}" Margin="0,4" />
                                                        <StackPanel />
                                                    </StackPanel>
                                                </Flyout>
                                            </DropDownButton.Flyout>
                                        </DropDownButton>
                                        <ToggleSwitch IsOn="{x:Bind Enabled, Mode=TwoWay}" MinWidth="0" Margin="8,0,0,0"
                                                      AutomationProperties.Name="Schedule on" />
                                        <Button Style="{StaticResource SubtleIconButtonStyle}"
                                                Click="OnRemoveClick" Tag="{x:Bind}"
                                                AutomationProperties.Name="Remove schedule"
                                                ToolTipService.ToolTip="Remove schedule">
                                            <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="No schedules yet"
                           Visibility="{x:Bind EmptyVisibility, Mode=OneTime}"
                           Style="{StaticResource SecondaryCaptionStyle}" Margin="1,4,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
