<Page
    x:Class="TVControlForWin.Views.HotkeysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TVControlForWin.ViewModels"
    xmlns:controls="using:TVControlForWin.Controls">

    <Grid RowDefinitions="Auto,*">
        <TextBlock Text="Hotkeys" Style="{StaticResource PageTitleStyle}" />

        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled">
            <StackPanel Style="{StaticResource PageContentStyle}">

                <!-- The modifier keys; the line under the label shows the whole shortcut. -->
                <controls:SettingCard Header="Shortcut" Glyph="&#xE765;"
                                      Description="{x:Bind VM.HotkeyComboText, Mode=OneWay}"
                                      InfoText="Hold these keys and press the Up or Down arrow to change brightness. At least one key stays selected. A shortcut that another app already uses can't be taken. Choose other keys.">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox MinWidth="0" Content="Ctrl" Tag="ctrl" IsChecked="{x:Bind VM.HotkeyCtrl, Mode=OneWay}" Click="OnModifierClick" />
                            <CheckBox MinWidth="0" Content="Alt" Tag="alt" IsChecked="{x:Bind VM.HotkeyAlt, Mode=OneWay}" Click="OnModifierClick" />
                            <CheckBox MinWidth="0" Content="Shift" Tag="shift" IsChecked="{x:Bind VM.HotkeyShift, Mode=OneWay}" Click="OnModifierClick" />
                            <CheckBox MinWidth="0" Content="Win" Tag="win" IsChecked="{x:Bind VM.HotkeyWin, Mode=OneWay}" Click="OnModifierClick" />
                        </StackPanel>
                        <!-- Shown only while Windows refuses the shortcut because another app holds it. -->
                        <TextBlock HorizontalAlignment="Right"
                                   Style="{StaticResource SecondaryCaptionStyle}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   Text="{x:Bind VM.HotkeyConflictText, Mode=OneWay}"
                                   Visibility="{x:Bind VM.HotkeyConflictVisibility, Mode=OneWay}" />
                    </StackPanel>
                </controls:SettingCard>

                <controls:SettingCard Header="Brightness step" Glyph="&#xE706;">
                    <NumberBox Width="150" Minimum="1" Maximum="25"
                               SpinButtonPlacementMode="Inline"
                               Value="{x:Bind VM.HotkeyStep, Mode=TwoWay}" />
                </controls:SettingCard>

                <!-- Which TV(s) the shortcut changes. Only with more than one TV. -->
                <controls:SettingCard Header="Which TV" Glyph="&#xE7F4;"
                                      Visibility="{x:Bind VM.HotkeyTargetVisibility, Mode=OneWay}"
                                      InfoText="&quot;TV under the cursor&quot; changes the TV on the screen your cursor is on. Choose each TV's screen on the Home page. On a screen with no TV, nothing changes.">
                    <ComboBox MinWidth="200"
                              ItemsSource="{x:Bind VM.HotkeyTargets}"
                              SelectedItem="{x:Bind VM.SelectedHotkeyTarget, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TvChoice">
                                <TextBlock Text="{x:Bind Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
