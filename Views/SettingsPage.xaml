<Page
    x:Class="TVControlForWin.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TVControlForWin.Controls">

    <Grid RowDefinitions="Auto,*">
        <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />

        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled">
            <StackPanel Style="{StaticResource PageContentStyle}">

                <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderStyle}" Margin="1,0,0,4" />
                <controls:SettingCard Header="Theme" Glyph="&#xE790;">
                    <ComboBox MinWidth="200" SelectedIndex="{x:Bind VM.ThemeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Use system setting" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </controls:SettingCard>

                <TextBlock Text="Startup" Style="{StaticResource SectionHeaderStyle}" />
                <controls:SettingCard Header="Start with Windows" Glyph="&#xE7E8;">
                    <ToggleSwitch MinWidth="0" IsOn="{x:Bind VM.StartWithWindows, Mode=TwoWay}" />
                </controls:SettingCard>
                <controls:SettingCard Header="At sign-in, show" Glyph="&#xE737;"
                                      IsEnabled="{x:Bind VM.StartWithWindows, Mode=OneWay}">
                    <ComboBox MinWidth="200" SelectedIndex="{x:Bind VM.LaunchBehavior, Mode=TwoWay}">
                        <ComboBoxItem Content="Window" />
                        <ComboBoxItem Content="Minimised" />
                        <ComboBoxItem Content="Tray icon only" />
                    </ComboBox>
                </controls:SettingCard>

                <TextBlock Text="Backup" Style="{StaticResource SectionHeaderStyle}" />
                <controls:SettingCard Header="Settings file" Glyph="&#xE8A5;"
                                      Description="Includes TVs, pairing and schedules">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Export" MinWidth="88" Click="OnExportClick" />
                        <Button Content="Import" MinWidth="88" Click="OnImportClick" />
                    </StackPanel>
                </controls:SettingCard>

                <TextBlock Text="Updates" Style="{StaticResource SectionHeaderStyle}" />
                <controls:SettingCard Header="{x:Bind VM.Updates.VersionLabel}" Glyph="&#xE895;"
                                      Description="{x:Bind VM.Updates.StatusText, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ProgressRing Width="16" Height="16" VerticalAlignment="Center"
                                      IsActive="{x:Bind VM.Updates.IsBusy, Mode=OneWay}" />
                        <Button MinWidth="96" VerticalAlignment="Center"
                                Content="{x:Bind VM.Updates.ButtonText, Mode=OneWay}"
                                IsEnabled="{x:Bind VM.Updates.ButtonEnabled, Mode=OneWay}"
                                Click="OnUpdateClick" />
                    </StackPanel>
                </controls:SettingCard>
                <controls:SettingCard Header="Check automatically" Glyph="&#xE72C;"
                                      InfoText="Looks on GitHub for a new version about once a day.">
                    <ToggleSwitch MinWidth="0" IsOn="{x:Bind VM.Updates.CheckAutomatically, Mode=TwoWay}" />
                </controls:SettingCard>
                <controls:SettingCard Header="Install automatically" Glyph="&#xE896;"
                                      IsEnabled="{x:Bind VM.Updates.CheckAutomatically, Mode=OneWay}"
                                      Visibility="{x:Bind VM.Updates.InstallAutomaticallyVisibility}"
                                      InfoText="A new version is downloaded in the background and installed once this window is closed. The app restarts as a tray icon. If the app is installed for all users, Windows has to ask for permission, so the update waits until you select Install here.">
                    <ToggleSwitch MinWidth="0" IsOn="{x:Bind VM.Updates.InstallAutomatically, Mode=TwoWay}" />
                </controls:SettingCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
