<Page
    x:Class="TVControlForWin.Views.PowerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TVControlForWin.ViewModels"
    xmlns:controls="using:TVControlForWin.Controls">

    <Grid RowDefinitions="Auto,*">
        <TextBlock Text="Power" Style="{StaticResource PageTitleStyle}" />

        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled">
            <StackPanel Style="{StaticResource PageContentStyle}">

                <!-- Whose rules the controls below show: the shared ones, or one TV's. Only with more than one TV. -->
                <StackPanel Spacing="4" Margin="0,0,0,20" Visibility="{x:Bind VM.PowerScopeVisibility, Mode=OneWay}">
                    <controls:SettingCard Header="Rules for">
                        <ComboBox MinWidth="200"
                                  ItemsSource="{x:Bind VM.PowerScopes}"
                                  SelectedItem="{x:Bind VM.SelectedPowerScope, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:TvChoice">
                                    <TextBlock Text="{x:Bind Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls:SettingCard>

                    <controls:SettingCard Header="Separate rules for this TV"
                                          Description="When off, it follows the rules for All TVs"
                                          Visibility="{x:Bind VM.PowerSeparateVisibility, Mode=OneWay}">
                        <ToggleSwitch MinWidth="0" IsOn="{x:Bind VM.PowerUseSeparateRules, Mode=TwoWay}" />
                    </controls:SettingCard>
                </StackPanel>

                <!-- The rules. Read-only while a TV that follows the shared rules is selected. The
                     section headers stay outside the read-only part so their info stays readable. -->
                <StackPanel Style="{StaticResource SectionHeaderPanelStyle}" Margin="1,0,0,4">
                    <TextBlock Text="Turn on" Style="{StaticResource SectionHeaderTextStyle}" />
                    <controls:InfoTip Title="Turning TVs on"
                                      Text="LG: on the TV, turn on Quick Start+ and &quot;Turn on via Wi-Fi&quot;. They're under General &gt; Devices, or General &gt; External Devices on some models. Then let the app connect once while the TV is on.&#10;&#10;Google TV: on the TV, set Settings &gt; System &gt; Power &amp; Energy &gt; Energy Modes to &quot;Increased (Always connected)&quot;, so it stays reachable in standby." />
                </StackPanel>
                <ContentControl IsTabStop="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                IsEnabled="{x:Bind VM.PowerRules.IsEditable, Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <controls:SettingCard Header="When the app starts"
                                              Description="At sign-in, if Start with Windows is on">
                            <ToggleSwitch MinWidth="0" IsOn="{x:Bind VM.PowerRules.OnAppStart, Mode=TwoWay}" />
                        </controls:SettingCard>
                        <controls:SettingCard Header="When the PC wakes from sleep">
                            <ToggleSwitch MinWidth="0" IsOn="{x:Bind VM.PowerRules.OnResume, Mode=TwoWay}" />
                        </controls:SettingCard>
                    </StackPanel>
                </ContentControl>

                <TextBlock Text="Turn off" Style="{StaticResource SectionHeaderStyle}" />
                <ContentControl IsTabStop="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                IsEnabled="{x:Bind VM.PowerRules.IsEditable, Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <controls:SettingCard Header="When the PC goes to sleep">
                            <ToggleSwitch MinWidth="0" IsOn="{x:Bind VM.PowerRules.OffOnSleep, Mode=TwoWay}" />
                        </controls:SettingCard>
                        <controls:SettingCard Header="When the PC shuts down"
                                              Description="Also on restart and sign-out">
                            <ToggleSwitch MinWidth="0" IsOn="{x:Bind VM.PowerRules.OffOnShutdown, Mode=TwoWay}" />
                        </controls:SettingCard>
                    </StackPanel>
                </ContentControl>

                <!-- Follow Windows turning the screens off after the idle time. -->
                <StackPanel Style="{StaticResource SectionHeaderPanelStyle}">
                    <TextBlock Text="Screen timeout" Style="{StaticResource SectionHeaderTextStyle}" />
                    <controls:InfoTip Title="When Windows turns the screens off"
                                      Text="Screen off: the picture goes dark but the TV stays on, so it comes back instantly. Google TVs can't do this and turn off instead.&#10;&#10;Turn off: saves more power. The TV takes a few seconds to come back.&#10;&#10;Most LG TVs turn themselves off a few minutes after the picture stops, even with Screen off. Keep &quot;Turn on via Wi-Fi&quot; on so the app can wake them." />
                </StackPanel>
                <ContentControl IsTabStop="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                IsEnabled="{x:Bind VM.PowerRules.IsEditable, Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <controls:SettingCard Header="When the screens turn off">
                            <ToggleSwitch MinWidth="0" IsOn="{x:Bind VM.PowerRules.FollowDisplayOff, Mode=TwoWay}" />
                        </controls:SettingCard>
                        <controls:SettingCard Header="What the TV does"
                                              IsEnabled="{x:Bind VM.PowerRules.FollowDisplayOff, Mode=OneWay}">
                            <ComboBox MinWidth="200" SelectedIndex="{x:Bind VM.PowerRules.DisplayOffAction, Mode=TwoWay}">
                                <ComboBoxItem Content="Screen off" />
                                <ComboBoxItem Content="Turn off" />
                            </ComboBox>
                        </controls:SettingCard>
                        <controls:SettingCard Header="When the screens turn back on">
                            <ToggleSwitch MinWidth="0" IsOn="{x:Bind VM.PowerRules.FollowDisplayOn, Mode=TwoWay}" />
                        </controls:SettingCard>
                    </StackPanel>
                </ContentControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
