<Page
    x:Class="TVControlForWin.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TVControlForWin.ViewModels"
    xmlns:local="using:TVControlForWin.Views"
    xmlns:controls="using:TVControlForWin.Controls"
    Loaded="OnPageLoaded"
    Unloaded="OnPageUnloaded">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- SSDP auto-discovery: scans the LAN for supported TVs and adds them by one click. Lives in
             the visual tree (it renders nothing until shown) — a ContentDialog in Page.Resources
             dims the page but never draws its content. -->
        <ContentDialog x:Name="DiscoverDialog"
                       Title="Find TVs"
                       PrimaryButtonText="Search again"
                       CloseButtonText="Done"
                       DefaultButton="Close"
                       PrimaryButtonClick="OnScanAgainClick">
            <StackPanel Spacing="12" MinWidth="400">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <ProgressRing x:Name="ScanRing" Width="16" Height="16" IsActive="False" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Name="ScanStatus" Text="Searching" TextWrapping="Wrap" />
                        <TextBlock x:Name="ScanHint" Style="{StaticResource SecondaryCaptionStyle}" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
                <ItemsControl x:Name="DiscoveredList" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:DiscoveredTvItem">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,6">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Details}" Style="{StaticResource SecondaryCaptionStyle}" />
                                </StackPanel>
                                <Button Grid.Column="1" MinWidth="88" VerticalAlignment="Center"
                                        Content="{x:Bind ButtonText, Mode=OneWay}"
                                        IsEnabled="{x:Bind CanAdd, Mode=OneWay}"
                                        Click="OnAddDiscoveredClick" Tag="{x:Bind}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ContentDialog>

        <TextBlock Grid.Row="0" Text="Home" Style="{StaticResource PageTitleStyle}" />

        <!-- Add TV -->
        <Grid Grid.Row="1" Margin="24,0,24,16" MaxWidth="{StaticResource ContentMaxWidth}"
              ColumnSpacing="8" ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Margin="1,8,0,0"
                       Style="{StaticResource SecondaryCaptionStyle}"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       Text="{x:Bind VM.AddError, Mode=OneWay}"
                       Visibility="{x:Bind VM.AddErrorVisibility, Mode=OneWay}" />
            <TextBox Grid.Column="0" PlaceholderText="Name (optional)"
                     AutomationProperties.Name="TV name"
                     Text="{x:Bind VM.NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Grid.Column="1" Width="160" PlaceholderText="IP address"
                     AutomationProperties.Name="IP address"
                     Text="{x:Bind VM.NewHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="2" Content="Add TV" Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind VM.AddTvCommand}" />
            <Button Grid.Column="3" Click="OnFindTvsClick" AutomationProperties.Name="Find TVs"
                    ToolTipService.ToolTip="Search your network for TVs">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE721;" FontSize="14" />
                    <TextBlock Text="Find TVs" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- TV list -->
        <ListView Grid.Row="2" ItemsSource="{x:Bind VM.Tvs}"
                  Padding="24,0,24,24"
                  AutomationProperties.Name="TVs"
                  SelectionMode="None"
                  CanReorderItems="True" AllowDrop="True" ReorderMode="Enabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="MaxWidth" Value="{StaticResource ContentMaxWidth}" />
                    <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TvViewModel">
                    <Border Style="{StaticResource CardStyle}">
                        <!-- A StackPanel, not Grid rows: its spacing skips collapsed sections, and which
                             sections a card shows depends on what the TV can do. Every row keeps a 20px
                             first column 16 from the text, so dot, icons and labels line up. -->
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="20,*,Auto" ColumnSpacing="16">
                                <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center"
                                         Fill="{x:Bind StatusBrush, Mode=OneWay}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <!-- Hovering the line explains what to check while the TV can't be reached. -->
                                    <TextBlock Style="{StaticResource SecondaryCaptionStyle}"
                                               ToolTipService.ToolTip="{x:Bind StatusHelp, Mode=OneWay}">
                                        <Run Text="{x:Bind Host}" /><Run Text=" · " /><Run Text="{x:Bind KindLabel}" /><Run Text="{x:Bind PowerOnlyText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{x:Bind StatusText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <ProgressRing Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                                  IsActive="{x:Bind IsBusy, Mode=OneWay}" />
                                    <Button Style="{StaticResource SubtleIconButtonStyle}"
                                            Click="OnPowerClick" Tag="{x:Bind}"
                                            AutomationProperties.Name="Power"
                                            ToolTipService.ToolTip="Turn on or off">
                                        <FontIcon Glyph="&#xE7E8;" FontSize="16" />
                                    </Button>
                                    <Button Style="{StaticResource SubtleIconButtonStyle}"
                                            Click="OnRemoveClick" Tag="{x:Bind}"
                                            AutomationProperties.Name="Remove TV"
                                            ToolTipService.ToolTip="Remove TV">
                                        <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Brightness -->
                            <Grid ColumnDefinitions="20,*,Auto" ColumnSpacing="16"
                                  Visibility="{x:Bind BrightnessVisibility, Mode=OneWay}">
                                <FontIcon Grid.Column="0" Glyph="&#xE706;" FontSize="16" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                        AutomationProperties.Name="Brightness"
                                        Value="{x:Bind Backlight, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" MinWidth="40" TextAlignment="Right" VerticalAlignment="Center"
                                           Style="{StaticResource BodyStrongTextBlockStyle}">
                                    <Run Text="{x:Bind Backlight, Mode=OneWay}" /><Run Text="%" />
                                </TextBlock>
                            </Grid>

                            <!-- Pairing by code (Google TV): the TV shows a code, typed in here once. -->
                            <StackPanel Spacing="12" Visibility="{x:Bind PairingVisibility, Mode=OneWay}">
                                <Border Style="{StaticResource DividerStyle}" />
                                <controls:SettingCard Style="{StaticResource SettingRowStyle}"
                                                      Glyph="&#xE72E;" Header="Pair with this TV"
                                                      Description="{x:Bind PairingHelp, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBox Width="120" MaxLength="6" PlaceholderText="Code"
                                                 CharacterCasing="Upper" IsSpellCheckEnabled="False"
                                                 AutomationProperties.Name="Pairing code"
                                                 Visibility="{x:Bind CodeEntryVisibility, Mode=OneWay}"
                                                 Text="{x:Bind PairingCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 KeyDown="OnPairingCodeKeyDown" Tag="{x:Bind}" />
                                        <Button MinWidth="88" Style="{StaticResource AccentButtonStyle}"
                                                Content="{x:Bind PairButtonText, Mode=OneWay}"
                                                Click="OnPairClick" Tag="{x:Bind}" />
                                    </StackPanel>
                                </controls:SettingCard>
                            </StackPanel>

                            <!-- Brightness setup (Google TV): shown while brightness could work but isn't
                                 switched on yet. Replaced by the slider once it is. -->
                            <StackPanel Spacing="12" Visibility="{x:Bind BrightnessSetupVisibility, Mode=OneWay}">
                                <Border Style="{StaticResource DividerStyle}" />
                                <controls:SettingCard Style="{StaticResource SettingRowStyle}"
                                                      Glyph="&#xE706;" Header="Brightness"
                                                      Description="{x:Bind BrightnessSetupText, Mode=OneWay}"
                                                      InfoTitle="Turn on USB debugging"
                                                      InfoText="{x:Bind BrightnessSetupHelp}">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <ProgressRing Width="16" Height="16" VerticalAlignment="Center"
                                                      IsActive="{x:Bind BrightnessSetupBusy, Mode=OneWay}" />
                                        <Button MinWidth="88" VerticalAlignment="Center"
                                                Content="{x:Bind BrightnessSetupButtonText, Mode=OneWay}"
                                                Visibility="{x:Bind BrightnessSetupButtonVisibility, Mode=OneWay}"
                                                Click="OnSetUpBrightnessClick" Tag="{x:Bind}" />
                                    </StackPanel>
                                </controls:SettingCard>
                            </StackPanel>

                            <!-- Which Windows screen this TV is, for the cursor hotkeys and the on-screen
                                 display. Only shown when there's more than one screen to choose between. -->
                            <StackPanel Spacing="12" Visibility="{x:Bind ScreenPickerVisibility, Mode=OneWay}">
                                <Border Style="{StaticResource DividerStyle}" />
                                <controls:SettingCard Style="{StaticResource SettingRowStyle}"
                                                      Glyph="&#xE7C4;" Header="Screen"
                                                      InfoText="Choose which Windows screen this TV is. The hotkeys then change the TV under your cursor, and the on-screen display shows on the right TV.">
                                    <ComboBox MinWidth="200" VerticalAlignment="Center"
                                              ItemsSource="{x:Bind AvailableScreens}"
                                              DisplayMemberPath="Name"
                                              SelectedItem="{x:Bind SelectedScreen, Mode=TwoWay}"
                                              PlaceholderText="Choose a screen" />
                                </controls:SettingCard>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty state: no TVs yet. -->
        <StackPanel x:Name="EmptyState" Grid.Row="2" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="24,0,24,64" Spacing="8" MaxWidth="360">
            <FontIcon Glyph="&#xE7F4;" FontSize="48" Margin="0,0,0,8"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="No TVs yet" HorizontalAlignment="Center"
                       Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="Search your network, or enter an IP address above"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button HorizontalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource AccentButtonStyle}"
                    Click="OnFindTvsClick" AutomationProperties.Name="Find TVs">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE721;" FontSize="14" />
                    <TextBlock Text="Find TVs" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Page>
