<Page
    x:Class="TVControlForWin.Views.OsdPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TVControlForWin.Controls">

    <Grid RowDefinitions="Auto,*">
        <TextBlock Text="On-screen display" Style="{StaticResource PageTitleStyle}" />

        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled">
            <StackPanel Style="{StaticResource PageContentStyle}">

                <controls:SettingCard Header="Show on-screen display" Glyph="&#xE7F4;">
                    <ToggleSwitch MinWidth="0" IsOn="{x:Bind VM.OsdEnabled, Mode=TwoWay}" />
                </controls:SettingCard>

                <!-- The rest only matters while the display is on. -->
                <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderStyle}" />
                <ContentControl IsTabStop="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                IsEnabled="{x:Bind VM.OsdEnabled, Mode=OneWay}">
                    <StackPanel Spacing="4">

                        <controls:SettingCard Header="Position" Glyph="&#xE799;">
                            <ComboBox MinWidth="200" SelectedIndex="{x:Bind VM.OsdPosition, Mode=TwoWay}">
                                <ComboBoxItem Content="Bottom centre" />
                                <ComboBoxItem Content="Bottom left" />
                                <ComboBoxItem Content="Bottom right" />
                                <ComboBoxItem Content="Top centre" />
                                <ComboBoxItem Content="Top left" />
                                <ComboBoxItem Content="Top right" />
                            </ComboBox>
                        </controls:SettingCard>

                        <controls:SettingCard Header="Screen" Glyph="&#xE7C4;"
                                              InfoText="&quot;The TV being adjusted&quot; uses the screen chosen on each TV's card on the Home page.">
                            <ComboBox MinWidth="200" SelectedIndex="{x:Bind VM.OsdMonitor, Mode=TwoWay}">
                                <ComboBoxItem Content="Main screen" />
                                <ComboBoxItem Content="The TV being adjusted" />
                                <ComboBoxItem Content="Screen under the cursor" />
                            </ComboBox>
                        </controls:SettingCard>

                        <controls:SettingCard Header="Duration" Glyph="&#xE916;">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock VerticalAlignment="Center" MinWidth="36" TextAlignment="Right"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run x:Name="DurationValue" /><Run Text=" s" />
                                </TextBlock>
                                <Slider x:Name="DurationSlider" Width="200" VerticalAlignment="Center"
                                        AutomationProperties.Name="Duration in seconds"
                                        Minimum="0.5" Maximum="5" StepFrequency="0.1" SmallChange="0.1"
                                        Value="{x:Bind VM.OsdTimeoutSeconds, Mode=TwoWay}"
                                        ValueChanged="OnDurationChanged" />
                            </StackPanel>
                        </controls:SettingCard>

                        <controls:SettingCard Header="Show TV name" Glyph="&#xE8EC;">
                            <ToggleSwitch MinWidth="0" IsOn="{x:Bind VM.OsdShowTvName, Mode=TwoWay}" />
                        </controls:SettingCard>

                        <controls:SettingCard Header="Show when a schedule runs" Glyph="&#xE823;">
                            <ToggleSwitch MinWidth="0" IsOn="{x:Bind VM.OsdOnSchedule, Mode=TwoWay}" />
                        </controls:SettingCard>

                        <controls:SettingCard Header="Preview" Glyph="&#xE890;">
                            <Button Content="Show" MinWidth="88" Click="OnPreviewClick"
                                    AutomationProperties.Name="Show preview" />
                        </controls:SettingCard>
                    </StackPanel>
                </ContentControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
